# Alpine/musl Dockerfile for Retrigger -- smallest useful runtime image.
#
# The musl target is derived from the build machine's architecture rather than
# hardcoded, so this builds under `docker buildx --platform linux/amd64,linux/arm64`
# instead of only on x86-64. The C hash engine is compiled and statically linked
# by retrigger-core's build script, so there is no separate `make static` step
# and the runtime stage carries one self-contained binary.
#
# Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.alpine -t retrigger:alpine .

FROM alpine:3.24 AS builder

RUN apk add --no-cache \
        build-base \
        clang \
        pkgconfig \
        curl \
        ca-certificates \
        linux-headers \
        musl-dev

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# Alpine's host triple is already musl, so the native toolchain needs no
# cross-compilation setup; the explicit target only pins static linking.
RUN TARGET="$(uname -m)-unknown-linux-musl" \
    && rustup target add "$TARGET" \
    && cargo build --release --target "$TARGET" --bin retrigger \
    && install -m 0755 "target/$TARGET/release/retrigger" /tmp/retrigger \
    && /tmp/retrigger --version

FROM alpine:3.24 AS runtime
LABEL maintainer="Retrigger Team"
LABEL description="Ultra-fast file system watcher (Alpine minimal)"

RUN addgroup -g 1000 retrigger \
    && adduser -D -s /bin/sh -u 1000 -G retrigger retrigger

COPY --from=builder /tmp/retrigger /usr/local/bin/retrigger

RUN mkdir -p /etc/retrigger /var/lib/retrigger /var/log/retrigger \
    && chown -R retrigger:retrigger /var/lib/retrigger /var/log/retrigger

COPY deploy/docker/retrigger.toml /etc/retrigger/retrigger.toml

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s --retries=2 \
    CMD retrigger --version > /dev/null || exit 1

# One port: the 2.0 daemon serves the control API, the SSE change stream and
# /metrics from the same listener. 9091 was the old separate metrics port.
EXPOSE 9090

USER retrigger

ENTRYPOINT ["/usr/local/bin/retrigger"]
CMD ["start", "--config", "/etc/retrigger/retrigger.toml", "--foreground"]
