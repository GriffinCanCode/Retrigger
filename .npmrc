# npm reads .npmrc from the directory it runs in, not from repository ancestors.
# This copy covers commands run at the root; src/bindings/nodejs has its own.

# The lockfile is committed and CI installs with `npm ci`. Anything that lets a
# local `npm install` resolve differently from CI reintroduces exactly the
# "works on my machine" failure this project exists to eliminate.
package-lock=true

fund=false

# Install-time audit only. `npm audit --audit-level=moderate` still runs as its
# own CI job and still fails the build.
audit=false

# engine-strict is deliberately NOT set: it is evaluated against transitive
# dependencies too, and the CI matrix still builds on Node 18. Node support is
# asserted by the matrix, which actually runs the suite, rather than by a
# metadata check.
