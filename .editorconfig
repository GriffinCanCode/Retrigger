# Three toolchains share this tree, and each brings its own default indent.
# This file is what stops a C file opened in a JS-configured editor from
# arriving in review as a whitespace-only diff across the whole hash engine.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h}]
indent_size = 4
max_line_length = 80

[*.rs]
indent_size = 4
max_line_length = 100

[*.{js,mjs,cjs,ts,mts,cts,json,jsonc}]
indent_size = 2
max_line_length = 80

[*.{yml,yaml,toml}]
indent_size = 2

[*.py]
indent_size = 4

# Recipe lines are tab-significant; spaces here are a build failure, not a
# style opinion.
[{Makefile,*.mk,**/Makefile}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{package.json,package-lock.json,Cargo.lock}]
indent_size = 2
