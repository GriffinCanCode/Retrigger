# Ignore rules here are anchored ("/name") or path-qualified, never bare
# directory names. A bare "lib/" used to match this package's own lib/
# directory -- native.js and matcher.js, both listed in package.json "files" --
# so the published tarball contained sources that were not in the repository.
# Keep patterns specific, the same way the root .gitignore does.

# --- Dependencies --------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# npm is the package manager for this project. A second lockfile means two
# different dependency resolutions can both call themselves "installed".
yarn.lock
pnpm-lock.yaml

# --- Build output --------------------------------------------------------
# lib/ and plugins/ are SOURCE here and are deliberately absent from this list.
# .napi/ holds the .d.ts that `napi build` emits; index.js and index.d.ts are
# hand-written entry points, so the build redirects the generated one into here
# rather than overwriting them. The generated loader is suppressed outright
# with --no-js, since nothing consumes it.
#
# npm/ holds one directory per platform package, generated from napi.targets by
# `napi create-npm-dirs` and filled in by `napi artifacts` during a release.
# Committing it would mean a second, hand-stale copy of a list package.json
# already owns -- and the release regenerates it from scratch either way.
/.napi/
/npm/
/dist/
/out/
/build/
/prebuilds/
/target/
*.node
*.tgz

# --- Testing -------------------------------------------------------------
/coverage/
/.nyc_output/
*.lcov
.vitest/

# --- Caches and runtime scratch -----------------------------------------
.npm
.eslintcache
.node_repl_history
.cache/
.parcel-cache/
*.pid
*.seed
*.pid.lock

# --- Env -----------------------------------------------------------------
.env
.env.local
.env.test

# --- Editors / OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
