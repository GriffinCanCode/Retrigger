{
  "name": "@retrigger/core",
  "version": "2.0.0",
  "description": "Fast file watcher for Node.js dev servers: webpack and Vite plugins, native XXH3 content hashing that skips no-op rebuilds, and a zero-dependency JavaScript fallback so require() never throws",
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./webpack": {
      "types": "./plugins/webpack-plugin.d.ts",
      "import": "./plugins/webpack-plugin.mjs",
      "require": "./plugins/webpack-plugin.js",
      "default": "./plugins/webpack-plugin.js"
    },
    "./vite": {
      "types": "./plugins/vite-plugin.d.ts",
      "import": "./plugins/vite-plugin.mjs",
      "require": "./plugins/vite-plugin.js",
      "default": "./plugins/vite-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "lib/",
    "plugins/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "napi": {
    "binaryName": "retrigger-nodejs-bindings",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --no-js --dts .napi/binding.d.ts",
    "build:debug": "napi build --platform --no-js --dts .napi/binding.d.ts",
    "format": "prettier --write \"**/*.{js,mjs,json,md,ts}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,ts}\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npm run format:check && npm run typecheck",
    "prepublishOnly": "napi prepublish -t npm",
    "bench": "node ../../../tools/benchmarks/benchmark.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pack": "node scripts/verify-package.js",
    "test:all": "npm run test && npm run test:pack",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2",
    "@types/node": "^20.19.17",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2"
  },
  "optionalDependencies": {
    "@retrigger/core-darwin-arm64": "2.0.0",
    "@retrigger/core-darwin-x64": "2.0.0",
    "@retrigger/core-linux-arm64-gnu": "2.0.0",
    "@retrigger/core-linux-arm64-musl": "2.0.0",
    "@retrigger/core-linux-x64-gnu": "2.0.0",
    "@retrigger/core-linux-x64-musl": "2.0.0",
    "@retrigger/core-win32-arm64-msvc": "2.0.0",
    "@retrigger/core-win32-x64-msvc": "2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GriffinCanCode/Retrigger.git",
    "directory": "src/bindings/nodejs"
  },
  "keywords": [
    "file-watcher",
    "file-watching",
    "watcher",
    "watch-files",
    "fs-watch",
    "filesystem",
    "file-system",
    "chokidar",
    "watchpack",
    "fsevents",
    "inotify",
    "hmr",
    "hot-reload",
    "hot-module-replacement",
    "live-reload",
    "dev-server",
    "webpack",
    "webpack-plugin",
    "vite",
    "vite-plugin",
    "bundler",
    "build-tools",
    "development-tools",
    "native",
    "napi-rs",
    "node-api",
    "rust",
    "xxhash",
    "xxh3",
    "content-hash",
    "simd",
    "performance",
    "cross-platform"
  ],
  "author": "Griffin Strier",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/GriffinCanCode/Retrigger/issues"
  },
  "homepage": "https://github.com/GriffinCanCode/Retrigger#readme"
}
