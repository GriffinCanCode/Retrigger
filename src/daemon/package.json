{
  "name": "@retrigger/daemon",
  "version": "2.0.0",
  "description": "Standalone file watcher daemon: one inotify/FSEvents watcher and one XXH3 content hash shared by several processes over an HTTP/JSON API with server-sent events and Prometheus metrics. Optional — @retrigger/core watches in-process without it.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "retrigger": "bin/retrigger.js"
  },
  "files": [
    "index.js",
    "bin/retrigger.js",
    "config/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/post-install.js",
    "test": "node scripts/test-daemon.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GriffinCanCode/Retrigger.git",
    "directory": "src/daemon"
  },
  "homepage": "https://github.com/GriffinCanCode/Retrigger#readme",
  "bugs": {
    "url": "https://github.com/GriffinCanCode/Retrigger/issues"
  },
  "keywords": [
    "file-watcher",
    "file-watching",
    "watcher",
    "watch-files",
    "daemon",
    "filesystem",
    "file-system",
    "inotify",
    "fsevents",
    "watchman",
    "chokidar",
    "cli",
    "http-api",
    "sse",
    "server-sent-events",
    "prometheus",
    "metrics",
    "xxhash",
    "xxh3",
    "content-hash",
    "hot-reload",
    "dev-server",
    "development-tools",
    "rust",
    "native",
    "cross-platform"
  ],
  "author": "Griffin Strier",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "optionalDependencies": {
    "@retrigger/daemon-darwin-arm64": "2.0.0",
    "@retrigger/daemon-darwin-x64": "2.0.0",
    "@retrigger/daemon-linux-arm64": "2.0.0",
    "@retrigger/daemon-linux-x64": "2.0.0",
    "@retrigger/daemon-win32-arm64": "2.0.0",
    "@retrigger/daemon-win32-x64": "2.0.0"
  },
  "peerDependencies": {
    "@retrigger/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@retrigger/core": {
      "optional": true
    }
  }
}
