# Ignore rules are deliberately anchored (leading "/") or path-qualified rather
# than bare directory names. The previous version ignored "bin/", "lib/", and
# "obj/" globally, which silently excluded src/daemon/bin/retrigger -- the very
# file the daemon package declares in its "files" list. Keep patterns specific.

# --- Rust ---------------------------------------------------------------
/target/
**/target/

# Cargo.lock IS tracked. This repository ships a binary (the retrigger daemon),
# and a committed lockfile is what makes its builds reproducible across
# machines. Do not add it back to this file.

# --- C core -------------------------------------------------------------
/src/build/
/src/core/build/
*.o
*.d
*.gcda
*.gcno

# Compiled libraries (sources live in src/core/src, never commit outputs)
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.pdb

# --- Node ---------------------------------------------------------------
node_modules/
*.node
*.tgz
.npm/
npm-debug.log*
.vitest/
/coverage/
**/coverage/

# --- Build outputs ------------------------------------------------------
/dist/
**/dist/
/out/

# --- Test scratch -------------------------------------------------------
/test-output/
/test-results/
.tmp/
*.tmp

# --- Profiling ----------------------------------------------------------
*.prof
perf.data*
flamegraph.svg
*.profraw

# --- Editors / OS -------------------------------------------------------
# Personal editor state stays out, but the two files that describe the project
# rather than the developer are tracked. The pattern is ".vscode/*" and not
# ".vscode/" because git will not descend into an excluded directory, and a
# negation below an excluded directory never matches.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.zed/
*.swp
*.swo
*~
*.orig
*.rej
.DS_Store
Thumbs.db

# --- Logs / env ---------------------------------------------------------
*.log
logs/
.env
.env.local
